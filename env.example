# .env.example — copy to .env and fill in your values
# NEVER commit .env to Git (it's in .gitignore)

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Use the SERVICE KEY (long JWT starting with eyJ), NOT the anon key.
# The service key bypasses Row Level Security so the pipeline can write.
# In GitHub: Settings → Secrets and variables → Actions → New repository secret

# ── Optional tuning (overrides config.py defaults) ────────────────────────────
# DORMANCY_DAYS=30
# MAX_CONSECUTIVE_ERRORS=5
# MAX_CONCURRENT_FEEDS=20
# MAX_CONCURRENT_ARTICLES=10
# CRAWL_TIMEOUT_S=15

# ── Layer 2 (enrichment / clustering) — all optional, see enrichment/config.py ─
# ENRICH_BATCH_SIZE=1000
# ENRICH_MAX_AGE_HOURS=48
# ENRICH_TIME_BUDGET_MINUTES=0          # CI uses 100 (job timeout 120)
# ENRICH_CLAIM_LEASE_MINUTES=150        # must exceed the job timeout
# CLUSTERING_ENABLED=true
# CLUSTER_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# CLUSTER_JOIN_THRESHOLD=0.85
# CLUSTER_MERGE_THRESHOLD=0.845
# CLASSIFY_CONFIDENCE_THRESHOLD=0.30

# ── Tests ─────────────────────────────────────────────────────────────────────
# WIZER_TEST_DSN="host=localhost port=5432 user=postgres password=postgres"
